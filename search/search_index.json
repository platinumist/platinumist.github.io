text":"<p>\u5fae\u79ef\u5206\u51fa\u5377\u5728\u8fd1\u51e0\u5e74\u8f6c\u5411\u4e86\u7531\u5916\u6821\u8001\u5e08\u51fa\u5377\uff0c\u6574\u4f53\u98ce\u683c\u96be\u4ee5\u628a\u63e1\uff0c\u4e14\u7279\u522b\u559c\u6b22\u8003\u9ad8\u8003\u9898\uff08www\uff09\uff0c\u6240\u4ee5\u5728\u671f\u672b\u590d\u4e60\u7684\u65f6\u5019\u6700\u597d\u4e0d\u8981\u9762\u5411\u5386\u5e74\u5377\u590d\u4e60\uff0c\u53ef\u4ee5\u591a\u770b\u770b\u8bfe\u8868\uff0c\u505a\u8bfe\u540e\u4e60\u9898\uff0c\u628a\u5386\u5e74\u5377\u4f5c\u4e3a\u719f\u6089\u8003\u8bd5\u3001\u63d0\u5347\u624b\u611f\u7684\u5de5\u5177\u3002</p> <p>\u3010\u5b66\u4e60\u5929\u5730\u3011\u3010\u56de\u5fc6\u5377\u301125-26\u5b66\u5e74\u5fae\u79ef\u5206I\u671f\u4e2d\uff08tag\uff1avjf\uff0c\u5fae\u79ef\u5206\uff08\u7532\uff09\uff0c\u5fae\u79ef\u5206\uff08H\uff09\uff0c\u5362\u5174\u6c5f\uff0c\u671f\u4e2d\u8003\uff09 https://www.cc98.org/topic/6337063</p> <p>\u3010\u5b66\u4e60\u5929\u5730\u3011\u66f4\u65b0-\u5fae\u79ef\u5206\uff08\u7532\uff09\u2160\u671f\u4e2d/\u671f\u672b\u5386\u5e74\u5377\u8d44\u6e90\u6574\u7406 https://www.cc98.org/topic/5699073 </p> <p>\u3010\u5b66\u4e60\u5929\u5730\u30112025-2026\u79cb\u51ac\u5fae\u79ef\u5206\u7532(I)\u671f\u672b\u56de\u5fc6\u5377 https://www.cc98.org/topic/6398981</p> <p>\u6709\u7f3a\u5931\u7684\u90e8\u5206\u6216\u5bfb\u6c42\u7b54\u6848\u89e3\u6790\uff0c\u53ef\u4ee5\u641c\u7d22\u5fae\u4fe1\u516c\u4f17\u53f7\u201c\u8def\u8001\u5e08\u7684nonsense collection\u201d\u3002</p>"},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A0%E8%B5%84%E6%96%99/#_5","title":"\u5173\u4e8e\u7b14\u8bb0\uff1a","text":"<p>\u3010\u5b66\u4e60\u5929\u5730\u3011\u5f53\u4e86\u4e00\u5b66\u671f\u5fae\u79ef\u5206\u8bfe\u7a0b\u52a9\u6559\uff0c\u5199\u4e86\u4e00\u4efd\u5b66\u4e60\u8bb2\u4e49 https://www.cc98.org/topic/5782188</p> <p>\u3010\u5b66\u4e60\u5929\u5730\u3011\u3010\u5df2\u66f4\u65b0\u3011\u5fae\u79ef\u5206\uff08\u7532\uff09\u8fd1\u5341\u5e74\u671f\u672b\u771f\u9898\u77e5\u8bc6\u70b9\u6574\u7406\u9644\u771f\u9898\uff08tag\uff0c\u5fae\u79ef\u5206\uff0cvjf\uff0c\u671f\u672b\uff0c\u771f\u9898\uff0c\u5362\u5174\u6c5f\uff0c\u5fae\u7532\uff0c\u603b\u7ed3\uff0c\u5fae\u79ef\u5206\uff08\u7532\uff09\uff0c\u5fae\u79ef\u5206\uff08H\uff09\uff09 https://www.cc98.org/topic/6387120 (\u96be\u5ea6\u53ef\u80fd\u6bd4\u8f83\u9ad8\uff0c\u4f46\u5199\u7684\u76f8\u5f53\u4e0d\u9519)</p> <p>\u4ea6\u53ef\u53c2\u8003\u8fd9\u4e2a\uff1ahttps://yuanhongyi.github.io/zjucalc24/</p>"},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/","title":"\u5fae\u79ef\u5206\uff08\u7532\uff09\u2161","text":""},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/#_1","title":"\u57fa\u672c\u4fe1\u606f","text":""},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/#_2","title":"\u4fee\u8bfb\u5b66\u671f\uff1a\u5927\u4e00\u6625\u590f","text":""},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/#5","title":"\u5b66\u5206\uff1a5\u5b66\u5206","text":""},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/#_3","title":"\u8d44\u6599\u6536\u96c6","text":""},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/#_4","title":"\u5173\u4e8e\u5386\u5e74\u5377\uff1a","text":"<p>\uff0c\u4e0e\u5fae\u79ef\u5206\uff08\u2160\uff09\u76f8\u5bf9\u5e94\u7684\uff0c\u5fae\u79ef\u5206\uff08\u2161\uff09\u51fa\u5377\u5728\u8fd1\u51e0\u5e74\u8f6c\u5411\u4e86\u4e5f\u7531\u5916\u6821\u8001\u5e08\u51fa\u5377\uff0c\u6240\u4ee5\u5728\u671f\u672b\u590d\u4e60\u7684\u65f6\u5019\u6700\u597d\u4e0d\u8981\u9762\u5411\u5386\u5e74\u5377\u590d\u4e60\uff0c\u53ef\u4ee5\u591a\u770b\u770b\u8bfe\u8868\uff0c\u505a\u8bfe\u540e\u4e60\u9898\uff0c\u628a\u5386\u5e74\u5377\u4f5c\u4e3a\u719f\u6089\u8003\u8bd5\u3001\u63d0\u5347\u624b\u611f\u7684\u5de5\u5177\u3002</p> <p>\u540c\u6837\u4e0e\u5fae\u79ef\u5206\uff08\u2160\uff09\u7c7b\u4f3c\uff0c\u5fae\u4fe1\u516c\u4f17\u53f7\u201c\u8def\u8001\u5e08\u7684nonsense collection\u201d\u3002\u4e0a\u6709\u51e0\u4e4e\u5168\u90e8\u7684\u5386\u5e74\u5377\u548c\u624b\u5199\u89e3\u6790\uff0c\u53ef\u4f9b\u53c2\u8003\u3002</p> <p>\u4e0b\u9762\u653e\u4e00\u4e9b\u6574\u7406\u597d\u7684\u5386\u5e74\u5377\u3002</p> <p>\u3010\u5b66\u4e60\u5929\u5730\u3011\u5fae\u79ef\u5206\uff08\u7532\uff09II/\u5fae\u79ef\u5206\uff08\u4e59\uff09II\u671f\u4e2d/\u671f\u672b\u5386\u5e74\u5377\u5408\u96c6\uff08\u5fae\u79ef\u5206\u7532\u3001\u5fae\u79ef\u5206\u4e59\u3001\u5fae\u75322\u3001\u5fae\u4e592\uff09 https://www.cc98.org/topic/6154394</p>"},{"location":"%E5%BE%AE%E7%A7%AF%E5%88%86%EF%BC%88%E7%94%B2%EF%BC%89%E2%85%A1%E8%B5%84%E6%96%99/#_5","title":"\u5173\u4e8e\u7b14\u8bb0\uff1a","text":"<p>savia\u5927\u4f6c\u7684\u7f51\u7ad9\u4e0a\u4f9d\u65e7\u6709\u5fae\u79ef\u5206\u2161\u7684\u7b14\u8bb0\uff0c\u53ef\u4ee5\u67e5\u9605\u3002\u6253\u789f\u4ed3\u5e93</p> <p>\u4e5f\u53ef\u4ee5\u501f\u9274\u4e00\u4e0b\u8fd9\u4e2a\uff1a</p> <p>\u3010\u5b66\u4e60\u5929\u5730\u3011\u3010\u5fae\u79ef\u5206\u7532\u4e8c\u8f85\u5bfc\u8bb2\u4e49\u3011\u4e91\u5cf0\u670b\u8f85\u5fae\u7532\u4e8c\u63d0\u5347\u7ec4\u8bfe\u5802\u8d44\u6599\u5206\u4eab~ https://www.cc98.org/topic/5289554</p>"},{"location":"%E6%99%AE%E9%80%9A%E5%8C%96%E5%AD%A6%E5%AE%9E%E9%AA%8C%EF%BC%88%E4%B9%99%EF%BC%89%E8%B5%84%E6%96%99/","title":"\u666e\u901a\u5316\u5b66\u5b9e\u9a8c\uff08\u4e59\uff09","text":""},{"location":"%E6%99%AE%E9%80%9A%E5%8C%96%E5%AD%A6%E5%AE%9E%E9%AA%8C%EF%BC%88%E4%B9%99%EF%BC%89%E8%B5%84%E6%96%99/#_1","title":"\u57fa\u672c\u4fe1\u606f","text":""},{"location":"%E6%99%AE%E9%80%9A%E5%8C%96%E5%AD%A6%E5%AE%9E%E9%AA%8C%EF%BC%88%E4%B9%99%EF%BC%89%E8%B5%84%E6%96%99/#_2","title":"\u4fee\u8bfb\u5b66\u671f\uff1a\u5927\u4e00\u79cb\u51ac","text":""},{"location":"%E6%99%AE%E9%80%9A%E5%8C%96%E5%AD%A6%E5%AE%9E%E9%AA%8C%EF%BC%88%E4%B9%99%EF%BC%89%E8%B5%84%E6%96%99/#15","title":"\u5b66\u5206\uff1a1.5\u5b66\u520